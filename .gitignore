# 依赖
node_modules/

# 敏感：Cursor 会话、本机 Chrome/Playwright 数据目录（含 Cookie、cf_clearance 等）
data/

# 从控制台导出的用量 CSV 可能含使用明细，勿提交
*.csv

# 若曾在别处放置会话文件
auth.json
**/auth.json

# 本地环境变量（如 CURSOR_API_KEY）
.env
.env.*
!.env.example

# 本地报告（可能较大或含汇总；需要可自建目录并取消忽略）
reports/

# Dashboard 开发日志（含 PID、启动时间）
dashboard/logs/

# 本机扩展启用配置（勿提交）
config/plugins.local.json
plugins-private/

